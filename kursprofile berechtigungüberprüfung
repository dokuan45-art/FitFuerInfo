<?php
session_start();
require_once 'db.php';

// Beispielhafter Login-Check (angenommen, die User-ID ist in der Session gespeichert)
if (!isset($_SESSION['user_id'])) {
    die("Bitte zuerst einloggen.");
}

$aktueller_user_id = $_SESSION['user_id'];
$ist_admin = (isset($_SESSION['rolle']) && $_SESSION['rolle'] === 'admin');

// Kurse aus der Datenbank abrufen inklusive Ersteller-Name
$stmt = $pdo->query("SELECT k.*, b.username AS ersteller_name FROM kursprofile k JOIN benutzer b ON k.erstellt_von = b.id");
$kurse = $stmt->fetchAll(PDO::FETCH_ASSOC);
?>

